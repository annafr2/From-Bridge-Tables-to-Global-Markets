# =====================================================================
# NegoPlay — Environment Variables Template
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git!
# =====================================================================

# Google Gemini API key (required — default LLM provider)
GOOGLE_API_KEY=your_gemini_key_here

# Anthropic Claude API key (optional — cross-model validation)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API key (optional — cross-model validation)
OPENAI_API_KEY=your_openai_key_here

# Logging level
LOG_LEVEL=INFO

# Hard budget cap across ALL providers combined (USD)
BUDGET_CAP_USD=50

# Alert threshold (USD) — pause and review if exceeded
BUDGET_ALERT_USD=20
